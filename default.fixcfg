# STL Batch Fix configuration
# Source folder containing STL/OBJ files
INPUT_FOLDER = /mnt/sda2/STL/Fixing/

# Appended to output filename stem (blank = none)
OUTPUT_SUFFIX = 

# Vertex merge radius for T-junction fix
MERGE_DIST = 0.01

# Finest print layer in mm. Open boundaries smaller than this cannot reach the
# plate, so they are accepted instead of triggering another repair pass.
# 0 = require zero open edges (the old behaviour).
MIN_LAYER = 0.6

# Parallel worker processes (0 = auto from RAM and cores)
WORKERS = 0

# Budget for one mesh, whether it is a whole unsplit model or a single shell
# part. This is the limit almost every file is judged by.
TIMEOUT_PART = 600

# Ceiling for a file that splits, and nothing else. An unsplit model is capped
# by TIMEOUT_PART alone and never reaches this. A split file's cap is
#     min(TIMEOUT, TIMEOUT_PART * n_parts)
# so a 2-part file gets 1200s and a 40-part file gets 3600s rather than 24000s.
TIMEOUT = 3600

# Decimate threshold (0 = disabled)
MAX_FACES = 900000

# Walk subdirectories
RECURSIVE = True

