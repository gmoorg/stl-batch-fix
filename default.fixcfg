# STL Batch Fix configuration
# Source folder containing STL/OBJ files
INPUT_FOLDER = /mnt/sda2/STL/Fixing/

# Appended to output filename stem (blank = none)
OUTPUT_SUFFIX = 

# Vertex merge radius for T-junction fix
MERGE_DIST = 0.01

# Finest print layer; open boundaries smaller than this are accepted (0 = require zero)
MIN_LAYER = 0.6

# Parallel worker processes (0 = auto from RAM and cores)
WORKERS = 0

# Budget for one mesh: a whole unsplit model, or a single shell part
TIMEOUT_PART = 600

# Ceiling for split files only; cap is min(TIMEOUT, TIMEOUT_PART * n_parts)
TIMEOUT = 3600

# Percent of TIMEOUT_PART held back from Blender for the steps after it
BLENDER_RESERVE_PCT = 30

# Decimate threshold (0 = disabled)
MAX_FACES = 900000

# Walk subdirectories
RECURSIVE = True

