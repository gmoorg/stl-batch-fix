# Executed by Blender in --background mode, launched by libs/blender.py.
# NOT meant to be run directly — it requires variables injected via str.format():
#
#   src — input  PLY path (str)
#   dst — output PLY path (str)
#
# Exit codes:
#   0  — success (BLENDER_OK or BLENDER_OPEN printed to stdout)
#   1  — empty / unreadable mesh (BLENDER_EMPTY)
#   2  — non-manifold edges remain after repair (BLENDER_UNREPAIRED)
#
# **The boundary is PLY, not STL, and that is a correctness fix rather than a
# preference.**  STL stores no vertex table: every triangle carries its own
# three coordinate triples, so a mesh written out arrives as loose triangles
# and has to be welded back by proximity.  This script used to do exactly that
# — a hand-written parser calling bm.verts.new() three times per triangle, then
# `remove_doubles(dist=merge_dist)` with merge_dist = 0.01 mm ABSOLUTE.
#
# Measured (2026-09-17), the same sphere at shrinking sizes through both paths:
#
#     radius    shortest edge    STL path        PLY path
#     1.0 mm    0.049 mm         382v / 760f     382v / 760f
#     0.2 mm    0.0098 mm        361v / 718f     382v / 760f   <- damaged
#     0.05 mm   0.0024 mm        142v / 280f     382v / 760f   <- 63% gone
#
# And on a normal 20 mm sphere carrying one small bead, which is the case that
# actually occurs — jewellery, buttons, eyes, lace on a figurine:
#
#     bead 0.30 mm   764v / 1520f   764v / 1520f   389/389 bead verts
#     bead 0.20 mm   742v / 1476f   764v / 1520f   367/389   <- detail eaten
#     bead 0.10 mm   715v / 1422f   764v / 1520f   340/389   <- detail eaten
#
# The large sphere is untouched; the loss lands entirely on the small feature,
# and the model's own size (69 mm diagonal) gives no warning.  PLY carries the
# vertex table, so the mesh arrives welded — measured: 0 open edges on import
# and `remove_doubles` removing 0 vertices — and the merge distance disappears
# from the pipeline rather than needing to be calibrated.

# `struct` and `mathutils` are gone with the hand-written STL parser and the
# normal vote: Blender's own PLY operators do the I/O now, so nothing here
# unpacks bytes or builds vectors by hand.
import bpy, bmesh, sys, os

# These placeholders are substituted by `libs/blender.py` at runtime via
# `REPAIR_SCRIPT.format(...)` before the script is written to a temp file and
# passed to Blender's --python argument.  Do not replace them with hard-coded
# values — this file is a template, not a runnable script.
src = {src!r}
dst = {dst!r}

bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete()


def load_ply(path, bm):
    """Import a binary PLY and hand back a BMesh that is already welded.

    Replaces a hand-written STL parser that called `bm.verts.new()` three times
    per triangle — 311,187 loose vertices for a 103,729-face part — and then
    relied on `remove_doubles` to guess the vertex table back.  PLY carries the
    table, so nothing is guessed: measured on import, 0 open edges, 0
    non-manifold, and `remove_doubles` afterwards removes 0 vertices.
    """
    bpy.ops.wm.ply_import(filepath=path)
    imported = [o for o in bpy.context.scene.objects if o.type == 'MESH']
    if not imported:
        return 0
    obj = imported[0]
    bm.from_mesh(obj.data)
    n_faces = len(bm.faces)
    bpy.ops.object.select_all(action='SELECT')
    bpy.ops.object.delete()
    return n_faces


def write_ply_from_bm(path, bm):
    """Export a BMesh as a binary PLY through Blender's own exporter.

    Replaces ~15 lines of hand-packed STL bytes.  The vertex table survives, so
    whatever reads this back does not have to reconstruct it — and no normals
    are written, which is correct here: `mesh_io.write` derives them from the
    winding anyway, so the 12 bytes per triangle STL spends on them carry no
    information (measured: the old normal vote reported "agree: 801,
    disagree: 0").
    """
    mesh = bpy.data.meshes.new("Repaired")
    bm.to_mesh(mesh)
    obj = bpy.data.objects.new("Repaired", mesh)
    bpy.context.collection.objects.link(obj)
    bpy.ops.object.select_all(action='DESELECT')
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    bpy.ops.wm.ply_export(filepath=path, export_selected_objects=True,
                          ascii_format=False, export_normals=False,
                          export_uv=False, export_colors='NONE')


# `split_t_junctions` was here and is DELETED.  `libs/welder.py` owns
# T-junctions, and this implementation was wrong anyway: it scanned
# `len(e.link_faces) > 2` — NON-MANIFOLD edges — but a T-junction produces OPEN
# edges, so it found 0 of the 80 on `sphere_allbad`.


# --- the three things this script keeps doing ---------------------------------
#
# Each of these was written out three or four times with different local names,
# which is most of why step 6 read like a second, worse copy of step 4.  They
# are one-liners, but naming them is what makes the repair loop legible: the
# loop now says *what* it is doing rather than how to count an edge.


def count_defects(bm):
    """`(non_manifold, open)` edge counts — the loop's progress measure.

    Non-manifold is `not is_manifold and not is_boundary`: a boundary edge has
    one face and is therefore also non-manifold by Blender's definition, so
    without the second clause every hole would be counted twice.
    """
    nm = sum(1 for e in bm.edges if not e.is_manifold and not e.is_boundary)
    return nm, sum(1 for e in bm.edges if e.is_boundary)


def nm_faces_of(bm):
    """Every face touching an edge with three or more faces.

    A set, because a face touching two bad edges must not be deleted twice.
    """
    faces = set()
    for edge in bm.edges:
        if len(edge.link_faces) > 2:
            faces.update(edge.link_faces)
    return faces


def fill_holes(bm, quad_method='BEAUTY', ngon_method='BEAUTY'):
    """Fill every boundary loop and triangulate the patches.  Returns them.

    `recalc_face_normals` on the new faces is not optional: `holes_fill` does
    not guarantee the patch agrees with its neighbours, and a patch wound the
    wrong way is a seam that the next tool has to resolve.
    """
    boundary = [e for e in bm.edges if e.is_boundary]
    if not boundary:
        return []
    new_faces = [f for f in bmesh.ops.holes_fill(bm, edges=boundary,
                                                 sides=0).get('faces', [])
                 if f.is_valid]
    if not new_faces:
        return []
    bmesh.ops.recalc_face_normals(bm, faces=new_faces)
    result = bmesh.ops.triangulate(bm, faces=new_faces,
                                   quad_method=quad_method,
                                   ngon_method=ngon_method)
    return [f for f in result.get('faces', []) if f.is_valid]


def run_repair_loop(mesh, obj, label):
    prev_nm = prev_open = None
    stall_count = 0
    wide_used = False

    # Load mesh once; mutate in place across all passes (no to_mesh/from_mesh per pass).
    bm = bmesh.new()
    bm.from_mesh(mesh)

    for repair_pass in range(12):
        def say(message, _pass=repair_pass):
            """Log one line, already tagged with the label and pass number.

            The tag was repeated at four call sites as three-way string
            concatenation, which is a third of the line at some of them.
            """
            print(label + " pass " + str(_pass + 1) + ": " + message)

        # --- 4a: wire edge deletion (directly in BMesh — no Edit Mode needed) ---
        wire_edges = [e for e in bm.edges if len(e.link_faces) == 0]
        if wire_edges:
            bmesh.ops.delete(bm, geom=wire_edges, context='EDGES')

        # --- 4b: NM face deletion ---
        # Deleting only the offending faces sometimes cannot make progress:
        # the same edges come back non-manifold on the next pass because the
        # geometry around them is the problem.  So on the FIRST stalled pass —
        # and once only — also delete every face adjacent to one, cutting a
        # wider hole for the fill step to close.
        #
        # **Once only, because it is destructive and escalating.**  Each
        # widening removes a ring of sound geometry; repeating it every stalled
        # pass would eat outward from the defect without bound.  One attempt,
        # then the stall limit (4 passes rather than 2, below) gives the normal
        # deletion room to converge on the wider hole.  Measured on a real
        # model, the widening took 2,583 faces in one pass.
        widen_now = (stall_count == 1 and not wide_used)
        nm_faces = nm_faces_of(bm)
        if nm_faces and widen_now:
            neighbours = set()
            for face in nm_faces:
                for edge in face.edges:
                    neighbours.update(edge.link_faces)
            nm_faces.update(neighbours)
            say("wider NM deletion (" + str(len(nm_faces)) + " faces)")
            wide_used = True
        if nm_faces:
            bmesh.ops.delete(bm, geom=list(nm_faces), context='FACES')

        # --- 4c: fin vertex removal ---
        fin_verts = [v for v in bm.verts
                     if any(e.is_boundary for e in v.link_edges) and len(v.link_faces) == 1]
        if fin_verts:
            bmesh.ops.delete(bm, geom=fin_verts, context='VERTS')
            say("removed " + str(len(fin_verts)) + " fin verts")

        # --- 4d: hole fill ---
        if any(e.is_boundary for e in bm.edges):
            new_faces = fill_holes(bm)
            if repair_pass == 0 and new_faces:
                slivers = [f for f in new_faces if f.is_valid and f.calc_area() < 1e-6]
                if slivers:
                    bmesh.ops.delete(bm, geom=slivers, context='FACES')

            seen_junctions = set()
            for _ in range(100):
                bm.verts.ensure_lookup_table()
                junction = None
                for vert in bm.verts:
                    if vert.index in seen_junctions:
                        continue
                    if sum(1 for e in vert.link_edges if e.is_boundary) > 2:
                        junction = vert
                        break
                if junction is None:
                    break
                seen_junctions.add(junction.index)
                bad = [f for f in junction.link_faces
                       if sum(1 for e in f.edges if e.is_boundary) >= 2]
                if not bad:
                    bad = list(junction.link_faces)
                if bad:
                    bmesh.ops.delete(bm, geom=bad, context='FACES')

        # --- 4e: convergence check ---
        nm_now, open_now = count_defects(bm)

        say("nm=" + str(nm_now) + " boundary=" + str(open_now))

        converged = (nm_now == 0 and open_now == 0)
        stalled = False
        if prev_nm is not None and (nm_now + open_now) >= (prev_nm + prev_open):
            stall_count += 1
            limit = 4 if wide_used else 2
            if stall_count >= limit:
                say("no improvement, stopping early")
                stalled = True
        else:
            stall_count = 0
        prev_nm, prev_open = nm_now, open_now

        if converged or stalled:
            # Final cleanup: remove any NM faces left by the last holes_fill pass.
            if not converged:
                leftover = nm_faces_of(bm)
                if leftover:
                    bmesh.ops.delete(bm, geom=list(leftover), context='FACES')
            break

    # Sync back to mesh so the decimation step (which re-imports via mesh) sees the result.
    bm.to_mesh(mesh)

    # Return the final BMesh (caller must free it).
    return nm_now, open_now, bm


# `normal_vote` was here and is DELETED.  It compared each face's normal
# against the one stored in the file and voted on winding — but `mesh_io.write`
# derives normals from the winding, so they always agreed (measured:
# "agree: 801, disagree: 0"), and PLY carries no per-face normals at all.
# Orientation is `repairer`'s job, unconditionally, via `by_geometry` (D26).


def make_mesh_obj(bm, name):
    mesh = bpy.data.meshes.new(name)
    bm.to_mesh(mesh)
    obj = bpy.data.objects.new(name, mesh)
    bpy.context.collection.objects.link(obj)
    bpy.context.view_layer.objects.active = obj
    obj.select_set(True)
    return mesh, obj


# ---------------------------------------------------------------------------
# Step 1 — load the PLY
#
# One branch, not three.  The OBJ and ASCII-STL paths are gone: every mesh
# reaching this script comes from `mesh_io.write`, which emits one format, and
# `converter` handles anything else long before repair.
# ---------------------------------------------------------------------------
bm = bmesh.new()
n_faces = load_ply(src, bm)
print("PLY faces loaded: " + str(n_faces))
print("Verts loaded: " + str(len(bm.verts)))
if len(bm.verts) == 0:
    print("BLENDER_EMPTY: no vertices in PLY")
    sys.exit(1)

# ---------------------------------------------------------------------------
# Step 2 — merge doubles: DELETED, the mesh arrives welded.
#
# `remove_doubles(dist=merge_dist)` existed only to undo what STL did on the
# way in, and `merge_dist` was 0.01 mm ABSOLUTE — which measurably ate detail
# below ~0.2 mm (see the header).  PLY carries the vertex table, so there is
# nothing to merge: measured on import, 0 open edges and `remove_doubles`
# removing 0 vertices.
#
# `dissolve_degenerate` went with it.  It ran only `if removed > 0`, so on a
# welded mesh it never executed anyway, and degenerate faces are handled
# upstream by `repairer`'s CLEAN step (`meshing_remove_null_faces`).
#
# The `orig_normal` BMesh layer went too.  It stored each face's normal as read
# from the STL, for a vote that no longer runs — and PLY does not carry
# per-face normals at all, so there would be nothing to store.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Step 3 — T-junction split: DISABLED, `libs/welder.py` owns this.
#
# Not merely redundant — the implementation below is wrong. It scans
# `len(e.link_faces) > 2`, i.e. NON-MANIFOLD edges, but a T-junction produces
# OPEN edges: the unsplit neighbour's full-length edge has one face, and so do
# the two halves on the split side. Measured on `sphere_allbad`, which carries
# 80 T-junctions: this found and split ZERO of them.
#
# `welder` scans open edges, repairs 150 junctions in 2 rounds, and loses no
# vertices; this one splits one per outer pass with a full re-scan each time,
# capped at MAX_ITER = 200.
# ---------------------------------------------------------------------------
tj_splits = 0
print("T-junction splits: DISABLED (welder owns this)")

# ---------------------------------------------------------------------------
# Step 4 — normal vote: DISABLED, the guarded `by_geometry` owns winding.
#
# It compares each face's normal against the one stored in the STL and votes.
# That needs the MODELLER's normals to be independent evidence — but every mesh
# reaching this script has been through `mesh_io`, and `mesh_io.write` derives
# every normal from the winding by cross product. A reversed face therefore
# gets a reversed normal and the two always agree.
#
# Measured on `sphere_allbad`: "Normal vote — agree: 801, disagree: 0". The
# vote has nothing to vote on. `mesh_io.load` discards the stored normals
# anyway (it reads bytes 12:48 of each triangle, skipping 0:12).
# ---------------------------------------------------------------------------
print("Normal vote: DISABLED (by_geometry owns winding)")

# ---------------------------------------------------------------------------
# Early exit: mesh is already clean after merge_doubles — skip repair loop.
# Decimation is now handled by PyMeshLab before Blender is called, so Blender
# only sees meshes that need NM repair.
# ---------------------------------------------------------------------------
_pre_repair_nm   = sum(1 for e in bm.edges if len(e.link_faces) > 2)
_pre_repair_open = sum(1 for e in bm.edges if e.is_boundary)
if _pre_repair_nm == 0 and _pre_repair_open == 0:
    print("Mesh already clean — writing without repair")
    non_tris = [f for f in bm.faces if len(f.verts) != 3]
    if non_tris:
        bmesh.ops.triangulate(bm, faces=non_tris, quad_method='BEAUTY', ngon_method='BEAUTY')
    bm.normal_update()
    _dst_partial = dst + ".partial"
    write_ply_from_bm(_dst_partial, bm)
    bm.free()
    os.replace(_dst_partial, dst)
    print("BLENDER_OK")
    sys.exit(0)

# ---------------------------------------------------------------------------
# Step 5 — repair loop
# ---------------------------------------------------------------------------
mesh1, obj1 = make_mesh_obj(bm, "Model")
bm.free()
_loop1_nm, _loop1_open, bm_final = run_repair_loop(mesh1, obj1, "Repair")

# ---------------------------------------------------------------------------
# Step 6 — final cleanup and write.
# bm_final comes directly from run_repair_loop — it holds the last committed
# topology, measured before any bm.to_mesh/from_mesh round-trip, so its edge
# counts are authoritative and free of Edit Mode flag corruption.
# ---------------------------------------------------------------------------

# 6a — triangulate any non-triangle faces that leaked past the repair loop's
# 4d guard (degenerate n-gons triangulate() couldn't split). Step 4d now
# prevents NM-producing patches from reaching bm_final, so this should be rare.
import math as _math
non_tris = [f for f in bm_final.faces if len(f.verts) != 3]
if non_tris:
    bmesh.ops.triangulate(bm_final, faces=non_tris, quad_method='BEAUTY', ngon_method='BEAUTY')
    # Clean up any NM edges the triangulation diagonals created.
    after_tri = nm_faces_of(bm_final)
    if after_tri:
        bmesh.ops.delete(bm_final, geom=list(after_tri), context='FACES')
        # Re-fill the holes just opened.  SHORT_EDGE/EAR_CLIP rather than
        # BEAUTY: these patches sit where geometry was just removed, so the
        # conservative triangulation is the right one.
        if fill_holes(bm_final, quad_method='SHORT_EDGE',
                      ngon_method='EAR_CLIP'):
            # One final NM check — delete, but do not re-fill again, or this
            # becomes a loop with no termination argument.
            leftover = nm_faces_of(bm_final)
            if leftover:
                bmesh.ops.delete(bm_final, geom=list(leftover), context='FACES')

# 6b — fill any remaining boundary loops. The mesh is now fully triangulated.
# Walk each loop explicitly and try a direct face fill; roll back if it
# introduces NM edges.
boundary_edges = [e for e in bm_final.edges if e.is_boundary]
if boundary_edges:
    adj = {{}}
    for e in boundary_edges:
        v0, v1 = e.verts[0], e.verts[1]
        adj.setdefault(v0.index, []).append((v1, e))
        adj.setdefault(v1.index, []).append((v0, e))
    visited_edges = set()
    loops_filled = 0
    for start_e in boundary_edges:
        if id(start_e) in visited_edges:
            continue
        loop_verts = [start_e.verts[0]]
        visited_edges.add(id(start_e))
        cur = start_e.verts[1]
        prev_idx = start_e.verts[0].index
        closed = False
        for _ in range(1000):
            if cur.index == loop_verts[0].index:
                closed = True
                break
            loop_verts.append(cur)
            nexts = [(v, e) for v, e in adj.get(cur.index, [])
                     if v.index != prev_idx and id(e) not in visited_edges]
            if not nexts:
                break
            next_v, next_e = nexts[0]
            visited_edges.add(id(next_e))
            prev_idx = cur.index
            cur = next_v
        if closed and len(loop_verts) >= 3:
            try:
                nm_before = sum(1 for e in bm_final.edges if len(e.link_faces) > 2)
                bm_final.faces.ensure_lookup_table()
                new_f = bm_final.faces.new(loop_verts)
                bmesh.ops.recalc_face_normals(bm_final, faces=[new_f])
                patch_faces = [new_f]
                if len(loop_verts) > 3:
                    tri_result = bmesh.ops.triangulate(bm_final, faces=[new_f],
                                                       quad_method='BEAUTY', ngon_method='BEAUTY')
                    patch_faces = [f for f in tri_result.get('faces', []) if f.is_valid]
                nm_after = sum(1 for e in bm_final.edges if len(e.link_faces) > 2)
                if nm_after > nm_before:
                    valid_patch = [f for f in patch_faces if f.is_valid]
                    if valid_patch:
                        bmesh.ops.delete(bm_final, geom=valid_patch, context='FACES')
                else:
                    loops_filled += 1
            except Exception:
                pass
    if loops_filled:
        print("Final cleanup: directly filled " + str(loops_filled) + " boundary loop(s)")

# 6c — final authoritative validation directly from bm_final.
# No from_mesh round-trip: bm_final's counts are clean.
nm_final, open_final = count_defects(bm_final)
n_faces    = len(bm_final.faces)
max_open_len = 0.0
if open_final > 0:
    max_open_len = max(
        _math.sqrt((e.verts[1].co - e.verts[0].co).length_squared)
        for e in bm_final.edges if e.is_boundary
    )

if open_final > 0:
    print("Final nm edges: " + str(nm_final) + "  open edges: " + str(open_final) +
          "  max_open_len: " + str(round(max_open_len, 4)) + "mm")
else:
    print("Final nm edges: " + str(nm_final) + "  open edges: " + str(open_final))

if n_faces == 0:
    print("BLENDER_EMPTY: repair produced 0 faces")
    bm_final.free()
    sys.exit(1)
print("Faces after repair: " + str(n_faces))

# nm=0 but open edges remain — write the repaired file anyway (slicer handles open edges),
# then signal the wrapper to also save a .open.stl marker copy.
# Tiny gaps (< 0.5mm) are floating-point seams — signal them as OK instead.
_open_tol = 0.5  # mm
if nm_final > 0:
    print("BLENDER_UNREPAIRED: nm=" + str(nm_final) + " open=" + str(open_final))
    bm_final.free()
    sys.exit(2)

# 6d — write output.
# Refresh cached normals — face.normal goes stale after topology edits.
bm_final.normal_update()
_dst_partial = dst + ".partial"
write_ply_from_bm(_dst_partial, bm_final)
bm_final.free()
os.replace(_dst_partial, dst)

if open_final > 0 and max_open_len >= _open_tol:
    print("BLENDER_OPEN: open=" + str(open_final) + " max=" + str(round(max_open_len, 4)) + "mm")
else:
    print("BLENDER_OK")
